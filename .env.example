# ============================================================
# ResearchBridge AI — Environment Variables Example
# Copy to .env and fill in real values
# ============================================================

# Database
DB_URL=jdbc:mysql://localhost:3306/researchbridge_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT (must be at least 32 characters)
JWT_SECRET=researchbridge-change-this-to-a-long-random-secret-key-in-production
JWT_EXPIRATION_MS=86400000

# File Uploads
FILE_UPLOAD_DIR=./uploads

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000

# AI Provider
# Options: MOCK (default), OPENAI, GEMINI, WATSONX
AI_PROVIDER=MOCK

# OpenAI (required if AI_PROVIDER=OPENAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Google Gemini (required if AI_PROVIDER=GEMINI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# IBM watsonx.ai (required if AI_PROVIDER=WATSONX)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-13b-instruct-v2

# Email (optional — for email verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
